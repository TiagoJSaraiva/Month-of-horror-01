percent = 20.0

[resource]
script = ExtResource("1_card_data")
id = &"gunslinger"
display_name = "Gunslinger"
description = "-20% reload time and +20% fire rate."
rarity = 2
modifiers = Array[ExtResource("2_stat_modifier")]([SubResource("StatModifier_1"), SubResource("StatModifier_2")])
