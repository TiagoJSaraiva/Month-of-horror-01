[gd_resource type="Resource" script_class="CardData" format=3]

[ext_resource type="Script" path="res://cards/card_data.gd" id="1_card_data"]
[ext_resource type="Script" path="res://cards/stat_modifier.gd" id="2_stat_modifier"]

[sub_resource type="Resource" id="StatModifier_1"]
script = ExtResource("2_stat_modifier")
stat = 8
percent = -20.0

[sub_resource type="Resource" id="StatModifier_2"]
