[gd_scene format=3]

[ext_resource type="Script" path="res://main/main.gd" id="1_main"]
[ext_resource type="PackedScene" path="res://night/night.tscn" id="2_night"]
[ext_resource type="PackedScene" path="res://ui/dawn_overlay/dawn_overlay.tscn" id="3_dawn_overlay"]
[ext_resource type="PackedScene" path="res://ui/hud/hud.tscn" id="4_hud"]

[node name="Main" type="Node"]
script = ExtResource("1_main")

[node name="Hud" parent="." instance=ExtResource("4_hud")]

[node name="LowResView" type="SubViewportContainer" parent="."]
texture_filter = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
stretch = true
stretch_shrink = 2

[node name="SubViewport" type="SubViewport" parent="LowResView"]
audio_listener_enable_3d = true

[node name="Night" parent="LowResView/SubViewport" instance=ExtResource("2_night")]
unique_name_in_owner = true

[node name="DawnOverlay" parent="." instance=ExtResource("3_dawn_overlay")]
