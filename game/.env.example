# Configuração local desta máquina. Copie para .env (que não vai para o git) e ajuste.
# Uma variável de ambiente com o mesmo nome, se definida no sistema, vale mais que o .env.

# Caminho do executável do Godot 4.7.x (o arquivo, não a pasta). Exemplos:
#   Windows (Steam): C:\Program Files (x86)\Steam\steamapps\common\Godot Engine\godot.windows.opt.tools.64.exe
#   Windows (site):  C:\Godot\Godot_v4.7.2-stable_win64.exe
#   Linux (site):    /home/usuario/godot/Godot_v4.7.2-stable_linux.x86_64
GODOT_PATH=
